# ==============================================================================
# Portal Watts — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Obtain these values from:
#   - Local environment: output of `supabase status`
#   - Cloud environment: Supabase Project Settings -> API
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Client & Server)
# ------------------------------------------------------------------------------

# Public URL of the Supabase API gateway (default local port: 54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Anon Key (safe for browser exposure, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service Role Key (CRITICAL: Server-side only, bypasses RLS)
# DO NOT prefix with NEXT_PUBLIC_ and NEVER expose in client bundles
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
